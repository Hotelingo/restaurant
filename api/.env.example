# Server-only values for the FastAPI service. Never commit real secrets.
APP_ENV=local

# Runtime connection MUST use the non-owner restaurant_app role so RLS applies.
# Use the Neon *pooled* connection string for the API.
DATABASE_URL=postgresql://restaurant_app:<password>@<neon-pooled-host>/neondb?sslmode=require

# Neon Managed Better Auth. JWTs are EdDSA-verified against this JWKS.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

CORS_ORIGINS=http://localhost:3000

# S3-compatible object storage (Neon bucket or equivalent) for private uploads.
STORAGE_BUCKET=uploads
AWS_REGION=<region>
AWS_ENDPOINT_URL_S3=<s3-compatible-endpoint>
AWS_ACCESS_KEY_ID=<scoped-key>
AWS_SECRET_ACCESS_KEY=<scoped-secret>

# Malware scanning. Required outside local/test/ci -- uploads fail closed without it.
# CLAMAV_HOST=<clamd-host>
# CLAMAV_PORT=3310
# Test stacks without ClamAV may opt out explicitly. Allowed only when APP_ENV is
# staging or preview; each file is recorded with scanner "unscanned-testing".
# Test data only -- never real customer files.
# MALWARE_SCAN_MODE=unscanned_testing

# On-demand calculation worker (workers/trigger_server.py). Leave unset when the
# worker polls the queue itself (local development).
# CALC_WORKER_TRIGGER_URL=http://<worker-private-host>:<port>/run
# CALC_WORKER_TRIGGER_TOKEN=<same random token as the worker, 32+ chars>
