# Template for deploy/.env.deploy (git-ignored). Placeholders only; never commit real values.
DB_TARGET=preview
APP_ENV=preview

# Neon: three different logins for three jobs.
MIGRATION_DATABASE_URL=postgresql://<owner>:<password>@<neon-direct-host>/neondb?sslmode=require
APP_DATABASE_URL=postgresql://restaurant_app:<password>@<neon-pooled-host>/neondb?sslmode=require
WORKER_DATABASE_URL=postgresql://restaurant_worker:<password>@<neon-pooled-host>/neondb?sslmode=require

NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# The Vercel origin(s) of this environment's web app.
CORS_ORIGINS=https://<your-app>.vercel.app
# CORS_ORIGIN_REGEX=https://<project>-[a-z0-9-]+-<team>\.vercel\.app

STORAGE_BUCKET=<private-bucket>
AWS_REGION=<region>
# AWS_ENDPOINT_URL_S3=https://<account>.r2.cloudflarestorage.com   # only for non-AWS S3 (e.g. R2)
AWS_ACCESS_KEY_ID=<key scoped to this bucket>
AWS_SECRET_ACCESS_KEY=<secret>
